{
  "name": "@geekykalpesh/avatars",
  "version": "1.0.0",
  "description": "A collection of beautiful, lightweight avatar profile pictures for web & mobile projects with JS/TS API and CLI tool",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "avatars": "./bin/cli.js",
    "@geekykalpesh/avatars": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "png",
    "README.md",
    "LICENCE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-catalog.js && tsup",
    "dev": "tsup --watch",
    "test": "node tests/index.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "avatar",
    "avatars",
    "profile-picture",
    "placeholder",
    "user-avatar",
    "3d-avatars",
    "notion-avatars",
    "vibrent-avatars",
    "memoji",
    "cli",
    "npm-package"
  ],
  "author": "Kalpesh <https://github.com/geekykalpesh>",
  "contributors": [
    "alohe <https://github.com/alohe>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekykalpesh/avatars.git"
  },
  "bugs": {
    "url": "https://github.com/geekykalpesh/avatars/issues"
  },
  "homepage": "https://github.com/geekykalpesh/avatars#readme",
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
